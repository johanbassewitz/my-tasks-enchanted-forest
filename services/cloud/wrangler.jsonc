{
  "name": "daywhisper-cloud-preview",
  "main": "worker.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daywhisper-cloud-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "MONTHLY_FREE_LIMIT": "5",
    "MAX_DAILY_AI_REQUESTS": "0",
    "PADDLE_MODE": "sandbox",
    "PADDLE_PRICES": "{}"
  }
}
